# Example configuration for local testing with Docker services
# Copy this file to .env.test.local and adjust ports as needed

# Database Configuration (Docker)
DATABASE_HOST="127.0.0.1"
DATABASE_NAME="gumroad_test"
TEST_DATABASE_NAME="gumroad_test"
DATABASE_PORT=XXXX  # Replace with actual port from docker compose ps
DATABASE_USERNAME="root"
DATABASE_PASSWORD="password"
SKIP_NATIVE_MYSQL_RECONNECT="true"

# MongoDB Configuration (Docker)
MONGO_DATABASE_URL="localhost:XXXX"  # Replace with actual port
MONGO_DATABASE_NAME="gumroad_log_test"
MONGO_DATABASE_USERNAME=""
MONGO_DATABASE_PASSWORD=""

# Elasticsearch Configuration (Docker)
ELASTICSEARCH_HOST="http://localhost:XXXX"  # Replace with actual port

# Redis Configuration (Docker)  
REDIS_HOST="localhost:XXXX/0"  # Replace with actual port
SIDEKIQ_REDIS_HOST="localhost:XXXX/1"
RPUSH_REDIS_HOST="localhost:XXXX/2"
RACK_ATTACK_REDIS_HOST="localhost:XXXX/3"

# Memcached Configuration (Docker)
MEMCACHE_SERVERS="localhost:XXXX"  # Replace with actual port

# LocalStack Configuration (Docker)
LOCALSTACK_ENDPOINT="http://localhost:XXXX"  # Replace with actual port

# AWS Configuration for LocalStack (using dummy pattern)
AWS_ACCESS_KEY_ID="dummy_aws_localstack_access_key"
AWS_SECRET_ACCESS_KEY="dummy_aws_localstack_secret_key"

# Testing Configuration
RAILS_ENV="test"

# Instructions:
# 1. Start Docker services: docker compose -f docker/docker-compose-test-and-ci.yml up -d
# 2. Check port mappings: docker compose -f docker/docker-compose-test-and-ci.yml ps
# 3. Replace XXXX with actual port numbers from step 2
# 4. Run tests: set -a && source .env.test.local && set +a && bundle exec rspec spec/helpers/ --format progress